{
  "name": "api-core",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/api/core/src",
  "projectType": "library",
  "tags": [
    "scope:api",
    "type:core"
  ],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "^default"
      ],
      "options": {
        "cwd": "{projectRoot}",
        "commands": [
          "tsc --noEmit -p tsconfig.lib.json",
          "tsc --noEmit -p tsconfig.spec.json"
        ],
        "parallel": false
      }
    }
  }
}
