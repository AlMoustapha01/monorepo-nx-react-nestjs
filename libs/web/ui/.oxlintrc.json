{
  "extends": ["../.oxlintrc.web.json"],
  "rules": {
    "no-restricted-imports": [
      "error",
      {
        "patterns": [{ "group": ["@tanstack/*"], "message": "web-ui est purement visuel." }]
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/**/*.tsx"],
      "rules": {
        "lingui/no-unlocalized-strings": [
          "error",
          {
            "ignoreNames": [
              "as",
              "className",
              "key",
              "id",
              "type",
              "role",
              "variant",
              "size",
              "to",
              "href",
              "target",
              "rel",
              "data-slot",
              "htmlFor",
              "name",
              "aria-pressed",
              "aria-hidden"
            ],
            "ignoreFunctions": ["cva", "cn"],
            "ignore": ["^(p|div|span|button|h[1-6])$"]
          }
        ]
      }
    },
    {
      "files": ["**/*.spec.tsx", "**/*.stories.tsx", "**/routeTree.gen.ts"],
      "rules": {
        "lingui/no-unlocalized-strings": "off"
      }
    }
  ]
}
