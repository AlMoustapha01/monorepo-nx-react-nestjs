{
  "$schema": "../../node_modules/oxlint/configuration_schema.json",
  "extends": ["../../.oxlintrc.json"],
  "plugins": ["react", "jsx-a11y", "vitest"],
  "jsPlugins": ["eslint-plugin-lingui"],
  "rules": {
    "no-restricted-globals": [
      "error",
      {
        "name": "fetch",
        "message": "Passer par @nx-react-nestjs/web-data-access."
      }
    ],
    "no-restricted-properties": [
      "error",
      {
        "object": "window",
        "property": "fetch",
        "message": "Passer par @nx-react-nestjs/web-data-access."
      },
      {
        "object": "globalThis",
        "property": "fetch",
        "message": "Passer par @nx-react-nestjs/web-data-access."
      }
    ]
  },
  "overrides": [
    {
      "files": ["**/src/**/*.tsx"],
      "rules": {
        "lingui/no-unlocalized-strings": [
          "error",
          {
            "ignoreNames": [
              "as",
              "className",
              "key",
              "id",
              "type",
              "role",
              "variant",
              "size",
              "to",
              "href",
              "target",
              "rel",
              "data-slot",
              "htmlFor",
              "name",
              "aria-pressed",
              "aria-hidden"
            ]
          }
        ]
      }
    },
    {
      "files": ["**/*.spec.tsx", "**/*.stories.tsx", "**/routeTree.gen.ts"],
      "rules": {
        "lingui/no-unlocalized-strings": "off"
      }
    }
  ]
}
