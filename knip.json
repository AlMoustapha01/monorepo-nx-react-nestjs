{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "apps/api/src/{main,worker,migrate}.ts",
    "apps/api/drizzle.config.ts",
    "libs/*/*/src/index.ts",
    "libs/api/core/src/testing.ts",
    "libs/api/*/src/lib/infra/*.schema.ts",
    "libs/api/core/src/lib/**/*.schema.ts",
    "tools/dev/{setup,token,seed}.mts",
    "apps/web/src/main.tsx",
    "apps/web/lingui.config.ts",
    "libs/web/*/lingui.config.ts",
    "apps/web/src/routes/**/*.tsx",
    "libs/web/*/src/**/*.stories.tsx",
    "libs/web/*/.storybook/main.ts"
  ],
  "project": ["apps/api/**/*.ts", "apps/web/**/*.{ts,tsx}", "libs/**/*.{ts,tsx}", "tools/**/*.mts"],
  "ignore": ["apps/web/src/routeTree.gen.ts"],
  "ignoreDependencies": [
    "pino-pretty",
    "@nestjs/schematics",
    "@nx/.*",
    "@swc/helpers",
    "ts-node",
    "tw-animate-css",
    "tailwindcss",
    "eslint-plugin-lingui"
  ]
}
