{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "apps/api/src/main.ts",
    "apps/api/drizzle.config.ts",
    "libs/*/*/src/index.ts",
    "libs/api/core/src/testing.ts",
    "libs/api/*/src/lib/infra/*.schema.ts",
    "libs/api/core/src/lib/**/*.schema.ts",
    "tools/dev/{setup,token,seed}.mts"
  ],
  "project": ["apps/api/**/*.ts", "libs/**/*.ts", "tools/**/*.mts"],
  "ignoreDependencies": ["pino-pretty", "@nestjs/schematics", "@nx/.*", "@swc/helpers", "ts-node"]
}
