NODE_ENV=development
# Port de l'API.
PORT=3000
LOG_LEVEL=info

# Ports publiés par docker compose sur votre machine. Si l'un est déjà pris, changez-le ici
# ET dans l'URL correspondante ci-dessous : `pnpm dev:setup` vérifie qu'ils concordent.
POSTGRES_PORT=5432
REDIS_PORT=6379
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

DATABASE_URL=postgres://app:app@localhost:5432/app
REDIS_URL=redis://localhost:6379

# Relais de l'outbox et worker BullMQ dans ce process (false pour un process API seul).
JOBS_ENABLED=true

# Arrêt : délai /ready en 503 avant la fermeture (5000 derrière un load balancer), puis délai maximal.
SHUTDOWN_DRAIN_MS=0
SHUTDOWN_TIMEOUT_MS=25000

# Mailpit (docker compose). Sans SMTP_URL, les emails sont seulement journalisés.
SMTP_URL=smtp://localhost:1025
MAIL_FROM=Shop <no-reply@shop.local>

# Authentification de l'API : l'un OU l'autre.
#  - AUTH_JWT_SECRET (dev, tests) : secret HS256 partagé avec `pnpm dev:token`, 32 caractères minimum.
#    Refusé en production.
#  - AUTH_JWKS_URL : clés publiques du fournisseur d'identité. Avec le service d'auth local
#    (`pnpm nx serve auth`) : http://localhost:3100/api/auth/jwks, et commenter AUTH_JWT_SECRET.
AUTH_JWT_SECRET=change-me-change-me-change-me-change-me
# AUTH_JWKS_URL=http://localhost:3100/api/auth/jwks
AUTH_JWT_ISSUER=https://auth.local
AUTH_JWT_AUDIENCE=api
# Claims du tenant et des rôles, si le fournisseur ne les nomme pas ainsi (chemin pointé accepté).
# AUTH_TENANT_CLAIM=tenant_id
# AUTH_ROLES_CLAIM=roles

# Service d'authentification (apps/auth, Better Auth) : `pnpm nx serve auth`.
AUTH_PORT=3100
BETTER_AUTH_URL=http://localhost:3100
# Au moins 32 caractères. En production : généré (openssl rand -hex 32), jamais commité.
BETTER_AUTH_SECRET=change-me-change-me-change-me-change-me
# URL du front, pour les liens d'invitation.
AUTH_APP_URL=http://localhost:4200

# Origines du front autorisées (API et service d'auth), séparées par des virgules.
CORS_ORIGINS=http://localhost:4200

# OpenTelemetry (traces, métriques) : inactif sans endpoint. En local avec
# `docker compose --profile observability up -d` : http://localhost:4318 (OTLP_PORT).
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=api

# Sentry (erreurs inattendues uniquement) : inactif sans DSN.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Surcharge des feature flags (catalogue : FEATURE_FLAGS des contrats). Ex. : orders.cancellation=false ; storefront=true pour la boutique en local
FEATURE_FLAGS=

# Front web (Vite). Token de dev : `pnpm -s dev:token`, à coller dans VITE_DEV_TOKEN.
VITE_API_URL=http://localhost:3000/api/v1
# VITE_DEV_TOKEN=
