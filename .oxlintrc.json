{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "jsPlugins": ["@nx/eslint-plugin"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "@nx/enforce-module-boundaries": [
      "error",
      {
        "depConstraints": [
          { "sourceTag": "scope:web", "onlyDependOnLibsWithTags": ["scope:web", "scope:shared"] },
          { "sourceTag": "scope:api", "onlyDependOnLibsWithTags": ["scope:api", "scope:shared"] },
          { "sourceTag": "scope:auth", "onlyDependOnLibsWithTags": ["scope:shared"] },
          { "sourceTag": "scope:e2e", "onlyDependOnLibsWithTags": [] },
          { "sourceTag": "scope:shared", "onlyDependOnLibsWithTags": ["scope:shared"] },
          {
            "sourceTag": "type:app",
            "onlyDependOnLibsWithTags": [
              "type:domain",
              "type:core",
              "type:contract",
              "type:feature",
              "type:ui",
              "type:data-access"
            ]
          },
          {
            "sourceTag": "type:domain",
            "onlyDependOnLibsWithTags": ["type:domain", "type:core", "type:contract"]
          },
          { "sourceTag": "type:core", "onlyDependOnLibsWithTags": ["type:core", "type:contract"] },
          { "sourceTag": "type:contract", "onlyDependOnLibsWithTags": ["type:contract"] },
          {
            "sourceTag": "type:feature",
            "onlyDependOnLibsWithTags": [
              "type:feature",
              "type:ui",
              "type:data-access",
              "type:contract"
            ]
          },
          { "sourceTag": "type:ui", "onlyDependOnLibsWithTags": ["type:ui"] },
          { "sourceTag": "type:data-access", "onlyDependOnLibsWithTags": ["type:contract"] }
        ]
      }
    ]
  },
  "env": {
    "builtin": true
  }
}
