{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "jsPlugins": ["@nx/eslint-plugin"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "@nx/enforce-module-boundaries": ["error", {
          "depConstraints": [
            { "sourceTag": "scope:web",    "onlyDependOnLibsWithTags": ["scope:web", "scope:shared"] },
            { "sourceTag": "scope:api",    "onlyDependOnLibsWithTags": ["scope:api", "scope:shared"] },
            { "sourceTag": "scope:shared", "onlyDependOnLibsWithTags": ["scope:shared"] },
            { "sourceTag": "type:app",      "onlyDependOnLibsWithTags": ["type:domain", "type:core", "type:contract"] },
            { "sourceTag": "type:domain",   "onlyDependOnLibsWithTags": ["type:domain", "type:core", "type:contract"] },
            { "sourceTag": "type:core",     "onlyDependOnLibsWithTags": ["type:core", "type:contract"] },
            { "sourceTag": "type:contract", "onlyDependOnLibsWithTags": ["type:contract"] }
          ]
    }]
  },
  "env": {
    "builtin": true
  }
}
