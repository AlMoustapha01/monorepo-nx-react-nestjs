{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2022",
    "module": "esnext",
    "lib": ["es2022", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strict": true,
    "paths": {
      "@nx-react-nestjs/contracts": ["./libs/shared/contracts/src/index.ts"],
      "@nx-react-nestjs/api-core": ["./libs/api/core/src/index.ts"],
      "@nx-react-nestjs/api-core/testing": ["./libs/api/core/src/testing.ts"],
      "@nx-react-nestjs/api-catalog": ["./libs/api/catalog/src/index.ts"],
      "@nx-react-nestjs/api-orders": ["./libs/api/orders/src/index.ts"],
      "@nx-react-nestjs/api-notifications": ["./libs/api/notifications/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
