{
  "extends": ["../../libs/web/.oxlintrc.web.json"],
  "ignorePatterns": ["src/routeTree.gen.ts"],
  "plugins": ["react-perf"],
  "overrides": [
    {
      "files": ["src/**/*.tsx"],
      "rules": {
        "lingui/no-unlocalized-strings": [
          "error",
          {
            "ignoreNames": [
              "as",
              "className",
              "key",
              "id",
              "type",
              "role",
              "variant",
              "size",
              "to",
              "href",
              "target",
              "rel",
              "data-slot",
              "htmlFor",
              "name",
              "aria-pressed",
              "aria-hidden",
              "aria-live",
              "direction",
              "align",
              "justify",
              "tone",
              "weight",
              "defaultPreload"
            ],
            "ignoreFunctions": [
              "document.getElementById",
              "useFeatureFlag",
              "createFileRoute",
              "requireFeature"
            ]
          }
        ]
      }
    },
    {
      "files": ["**/*.spec.tsx", "**/*.stories.tsx", "**/routeTree.gen.ts", "src/testing/**"],
      "rules": {
        "lingui/no-unlocalized-strings": "off"
      }
    }
  ]
}
