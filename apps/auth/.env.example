# Service d'identité (apps/auth, Better Auth) : `pnpm nx serve auth`. Lu avant le .env de la racine
# (variables communes), qui le complète.
AUTH_PORT=3100
BETTER_AUTH_URL=http://localhost:3100
# Au moins 32 caractères. Signe les cookies et chiffre les clés privées du JWKS (table auth.jwks) :
# le changer rend ces clés illisibles, à supprimer de la table. En production : généré
# (openssl rand -hex 32), jamais commité.
BETTER_AUTH_SECRET=change-me-change-me-change-me-change-me
# URL du front, pour les liens d'invitation.
AUTH_APP_URL=http://localhost:4200
